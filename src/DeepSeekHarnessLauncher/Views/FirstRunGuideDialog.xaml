<Window x:Class="DeepSeekHarnessLauncher.Views.FirstRunGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek Harness Launcher" Width="500" Height="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="#000000"
        ShowInTaskbar="False" FontFamily="Segoe UI">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="1">
        <StackPanel Margin="28">

            <!-- 应用标题与 logo -->
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="46" Height="46"/>
                <TextBlock Text="{DynamicResource Guide.FirstRunTitle}" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- 应用介绍 -->
            <TextBlock Text="{DynamicResource Lbl.Description}" TextWrapping="Wrap" Margin="0,16,0,0"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- 使用步骤 -->
            <TextBlock Text="{DynamicResource Guide.StepsTitle}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,8"/>
            <TextBlock x:Name="Step1Text" Text="{DynamicResource Guide.Step1}" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="Step2Text" Text="{DynamicResource Guide.Step2}" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="Step3Text" Text="{DynamicResource Guide.Step3}" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>

            <!-- 当前环境状态 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Guide.EnvStatusTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="NodeStatusText" FontSize="13" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DshStatusText" FontSize="13" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Button Content="{DynamicResource Guide.Start}" Width="120" Padding="0,8"
                    HorizontalAlignment="Right" Margin="0,22,0,0"
                    Click="Start_Click"/>

        </StackPanel>
    </Border>
</Window>
