<Window x:Class="DeepSeekHarnessLauncher.Views.DshDownloadFailedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek Harness Launcher" Width="480" Height="270"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="#000000"
        ShowInTaskbar="False" FontFamily="Segoe UI">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="1">
        <StackPanel Margin="24">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,14"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12">
                <TextBlock x:Name="CommandText" FontFamily="Consolas" FontSize="13"
                           TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource Btn.Cancel}" Width="90" Padding="0,7" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
                <Button Content="{DynamicResource Btn.CopyCommand}" Width="100" Padding="0,7" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="CopyCommand_Click"/>
                <Button Content="{DynamicResource Btn.OpenTerminal}" Width="100" Padding="0,7"
                        Click="OpenTerminal_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
