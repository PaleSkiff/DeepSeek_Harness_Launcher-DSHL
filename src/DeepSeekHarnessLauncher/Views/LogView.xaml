<UserControl x:Class="DeepSeekHarnessLauncher.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DeepSeekHarnessLauncher.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LogViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource Btn.Export}" Width="72" Padding="0,6" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExportCommand}"/>
                <Button Content="{DynamicResource Btn.CopyAll}" Width="82" Margin="8,0,0,0" Padding="0,6" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CopyAllCommand}"/>
                <Button Content="{DynamicResource Btn.Clear}" Width="60" Margin="8,0,0,0" Padding="0,6" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearViewCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="{DynamicResource Lbl.AutoScroll}" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Lbl.Level}" Margin="16,0,8,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Tag" Width="96">
                    <ComboBoxItem Content="{DynamicResource Lbl.All}" Tag="All"/>
                    <ComboBoxItem Content="DEBUG" Tag="Debug"/>
                    <ComboBoxItem Content="INFO" Tag="Info"/>
                    <ComboBoxItem Content="WARN" Tag="Warn"/>
                    <ComboBoxItem Content="ERROR" Tag="Error"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- 日志列表 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
            <ListBox x:Name="LogList" ItemsSource="{Binding EntriesView}"
                     FontFamily="Consolas" FontSize="12"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                       Foreground="{StaticResource TextMutedBrush}" Width="96"/>
                            <TextBlock Text="{Binding Level}" Width="56" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部信息条 -->
        <TextBlock Grid.Row="2" Text="{DynamicResource Lbl.LogSource}"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
