<UserControl x:Class="DeepSeekHarnessLauncher.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DeepSeekHarnessLauncher.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <!-- 应用信息卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="Bold" Margin="0,14,0,4"/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{DynamicResource Lbl.Version}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Version, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource Lbl.Description}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Bilibili -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Cursor="Hand"
                    MouseLeftButtonUp="OpenBilibili_Click">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lbl.Bilibili}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BilibiliName}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding BilibiliUrl}" Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap" TextDecorations="Underline"/>
                </StackPanel>
            </Border>

            <!-- QQ 交流群 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lbl.QqGroup}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding QqGroup}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
