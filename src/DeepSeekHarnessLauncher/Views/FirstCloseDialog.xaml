<Window x:Class="DeepSeekHarnessLauncher.Views.FirstCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dlg.CloseTitle}" Width="400" Height="230"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="#000000"
        ShowInTaskbar="False" FontFamily="Segoe UI">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="1">
        <StackPanel Margin="24">
            <TextBlock Text="{DynamicResource Dlg.ClosePrompt}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <CheckBox x:Name="RememberCheckBox" Content="{DynamicResource Lbl.RememberChoice}" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Lbl.ExitApp}" Width="100" Padding="0,7" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Exit_Click"/>
                <Button Content="{DynamicResource Lbl.MinimizeToTray}" Width="120" Padding="0,7" Click="Minimize_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
