<UserControl x:Class="DeepSeekHarnessLauncher.Views.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DeepSeekHarnessLauncher.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:EnvironmentViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Btn.Recheck}" Width="110" Padding="0,7"
                        Command="{Binding CheckCommand}"/>
                <TextBlock Text="{DynamicResource Lbl.Checking}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <TextBlock Text="{Binding Message}" Foreground="#5B8DEF" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding Message, Converter={StaticResource NullToVis}}"/>

            <!-- 安装进度与日志 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Group.InstallProgress}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,8"
                                 Background="{StaticResource SurfaceRaisedBrush}"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding InstallTitle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="InstallLogBox" Text="{Binding InstallLog, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" MinHeight="80" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Background="#0DFFFFFF" BorderThickness="0"
                             TextChanged="InstallLogBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- node.js -->
            <GroupBox Header="node.js" Padding="10" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                 Fill="{Binding NodeReady, Converter={StaticResource BoolToStateBrush}}"/>
                        <TextBlock Text="{Binding NodeStatusText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Lbl.NodeHint}"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{DynamicResource Btn.AutoInstall}" Width="150" Padding="0,6"
                                Command="{Binding InstallNodeCommand}"
                                IsEnabled="{Binding NodeReady, Converter={StaticResource InverseBool}}"/>
                        <Button Content="{DynamicResource Btn.Download}" Width="110" Margin="10,0,0,0" Padding="0,6"
                                Click="OpenNodeWebsite_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- DSH -->
            <GroupBox Header="DeepSeek Harness (DSH)" Padding="10" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Btn.InstallDsh}" Width="170" Padding="0,6"
                                Command="{Binding InstallDshCommand}" Margin="0,0,12,0"
                                IsEnabled="{Binding DshReady, Converter={StaticResource InverseBool}}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                     Fill="{Binding DshReady, Converter={StaticResource BoolToStateBrush}}"/>
                            <TextBlock Text="{Binding DshStatusText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Lbl.DshHint}"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- 检测输出 -->
            <GroupBox Header="{DynamicResource Group.CheckOutput}" Padding="10" Margin="0,16,0,0">
                <TextBox Text="{Binding Result.Output, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" MinHeight="120" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
