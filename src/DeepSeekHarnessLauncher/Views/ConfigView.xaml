<UserControl x:Class="DeepSeekHarnessLauncher.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DeepSeekHarnessLauncher.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ConfigViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource Btn.Save}" Width="80" Margin="6,0,0,0" Padding="0,6"
                        Command="{Binding SaveCommand}"/>
                <Button Content="{DynamicResource Btn.Cancel}" Width="80" Margin="6,0,0,0" Padding="0,6"
                        Command="{Binding CancelCommand}"/>
                <Button Content="{DynamicResource Btn.RestoreDefaults}" Width="90" Margin="6,0,0,0" Padding="0,6"
                        Command="{Binding ResetToDefaultsCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{DynamicResource Lbl.FormMode}" IsChecked="{Binding IsFormMode, Mode=TwoWay}"
                             GroupName="configMode" VerticalAlignment="Center"/>
                <RadioButton Content="{DynamicResource Lbl.TextMode}" Margin="12,0,0,0" VerticalAlignment="Center"
                             GroupName="configMode"
                             IsChecked="{Binding IsFormMode, Mode=TwoWay, Converter={StaticResource InverseBool}}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <!-- 表单模式 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsFormMode, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,8,0">
                    <GroupBox Header="{DynamicResource Group.ServiceCommand}" Padding="8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Lbl.Command}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Padding="2"
                                     Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Lbl.Arguments}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Padding="2"
                                     Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Lbl.WorkDir}" VerticalAlignment="Center"/>
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Btn.Browse}" Width="64" Margin="4,0,0,0"
                                        Click="BrowseWorkingDirectory_Click"/>
                                <TextBox Padding="2" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Lbl.EnvVars}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                                <DataGrid ItemsSource="{Binding EnvironmentVariables}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" Height="140" Margin="0,2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Col.Name}" Width="*"
                                                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTemplateColumn Header="{DynamicResource Col.Value}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 BorderThickness="0">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsValueVisible}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <TextBlock Text="••••••" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsValueVisible}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Button Grid.Column="1" Content="{DynamicResource Btn.Show}" Width="48" Margin="2,0"
                                                                Command="{Binding DataContext.ToggleValueVisibilityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{DynamicResource Btn.Delete}" Width="56" Margin="2,0"
                                                            Command="{Binding DataContext.RemoveEnvVarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="{DynamicResource Btn.AddEnvVar}" Width="140" HorizontalAlignment="Left"
                                        Command="{Binding AddEnvVarCommand}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Group.PortTimeout}" Padding="8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Lbl.Port}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,8,2" Padding="2"
                                     Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Lbl.StartTimeout}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Margin="0,2" Padding="2"
                                     Text="{Binding StartSecondsText, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Lbl.StopTimeout}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,8,2" Padding="2"
                                     Text="{Binding StopSecondsText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Group.HealthCheck}" Padding="8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Lbl.Address}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Margin="0,2,8,2" Padding="2"
                                     Text="{Binding HealthCheckUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Lbl.Interval}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" Margin="0,2" Padding="2"
                                     Text="{Binding HealthCheckIntervalText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource Group.Logging}" Padding="8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Lbl.RetentionDays}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Margin="0,2" Padding="2" Width="120" HorizontalAlignment="Left"
                                     Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </GroupBox>

                    <TextBlock Text="{Binding ValidationError}" Foreground="#C62828"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 文本模式 -->
            <Grid Visibility="{Binding IsFormMode, Converter={StaticResource InverseBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="4"/>
                <TextBlock Grid.Row="1" Text="{Binding JsonError}" Foreground="#C62828"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding JsonError, Converter={StaticResource NullToVis}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
