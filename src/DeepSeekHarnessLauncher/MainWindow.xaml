<Window x:Class="DeepSeekHarnessLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DeepSeekHarnessLauncher.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="DeepSeek Harness Launcher"
        Width="1000" Height="680"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <!-- 移除系统 resize 边框（避免顶部/四周白线），圆润圆角窗口四角 -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="16"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#D7DEE8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="{StaticResource WindowBackgroundBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏：一体化毛玻璃 -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#x2014;" Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click" ToolTip="{DynamicResource TitleBar.MinimizeTip}"/>
                        <Button Content="&#x2715;" Style="{StaticResource TitleBarButtonStyle}"
                                Click="CloseButton_Click" ToolTip="{DynamicResource TitleBar.CloseTip}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="DeepSeek Harness Launcher" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 主体：左侧导航 + 内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 侧边导航 -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedValue="{Binding SelectedNavKey, Mode=TwoWay}"
                             SelectedValuePath="Key"
                             Background="Transparent" BorderThickness="0"
                             Margin="0,12,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="10,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle x:Name="Indicator" Grid.Column="0" Width="4"
                                                               RadiusX="2" RadiusY="2"
                                                               Fill="{StaticResource PrimaryBrush}"
                                                               VerticalAlignment="Stretch"
                                                               Visibility="Collapsed"/>
                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                                      Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1F4080FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#26165DFF"/>
                                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="14"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="20"/>
            </Grid>

            <!-- 底部状态栏：与主页共享同一状态源 -->
            <Border Grid.Row="2" Background="{StaticResource TitleBarBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToBrush}}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#22C55E" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusStateText}" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="8,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusPortText}" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusPidText}" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
